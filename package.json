    "qs": "^6.16.0",
    "vitest": "^4.1.11",
    "@vitest/mocker": "^4.1.11",
    "postcss": "^8.5.18",
    "adm-zip": "^0.6.1",
    "js-yaml": "^4.3.2",
    "smol-toml": "^1.9.0",
    "vite": "^6.4.3"
  },
